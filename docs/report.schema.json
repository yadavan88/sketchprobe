{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sketchprobe/report.schema.json",
  "title": "sketchprobe report",
  "description": "Structured output of `sketchprobe --json`. Carries the same facts as the human report (spec FR-022). Failures use the same object with `diagnosis` set and `summary` empty. Integers are written exactly, so a consumer that reads numbers as doubles can lose precision above 2^53 (stream lengths, counts and KLL `n` can be that large); 64-bit hashes are strings.",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "input",
    "confidence",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "description": "Matches the process exit status: 0 success, 1 unreadable input, 2 not a recognizable sketch, 3 recognized but not decoded, 64 usage.",
      "enum": [
        0,
        1,
        2,
        3,
        64
      ]
    },
    "input": {
      "type": "object",
      "required": [
        "format",
        "formatSource",
        "bytes"
      ],
      "properties": {
        "format": {
          "enum": [
            "mongo-json",
            "json-string",
            "hex",
            "base64",
            "base64url",
            "raw",
            "unknown"
          ]
        },
        "formatSource": {
          "enum": [
            "detected",
            "forced"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "alternatives": {
          "description": "Other encodings that also parsed (present when the input was ambiguous).",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "format",
              "identified"
            ],
            "properties": {
              "format": {
                "type": "string"
              },
              "identified": {
                "type": "boolean"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "header": {
      "description": "Present whenever at least 8 bytes decoded.",
      "type": "object",
      "required": [
        "byte0",
        "preambleSize",
        "preambleUnit",
        "serVer",
        "familyId",
        "rawPrefixHex"
      ],
      "properties": {
        "byte0": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "preambleSize": {
          "type": "integer",
          "minimum": 0
        },
        "preambleUnit": {
          "enum": [
            "longs",
            "ints",
            "unknown"
          ]
        },
        "resizeFactor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "serVer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "familyId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "rawPrefixHex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        }
      }
    },
    "family": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "layout": {
          "type": "string"
        },
        "supported": {
          "type": "boolean"
        }
      }
    },
    "confidence": {
      "type": "object",
      "required": [
        "level",
        "evidence"
      ],
      "properties": {
        "level": {
          "enum": [
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check",
              "passed"
            ],
            "properties": {
              "check": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "summary": {
      "description": "Family-specific facts, empty on failure. Keys are stable per family: estimate, lowerBound1..3, upperBound1..3 (HLL, Theta); theta, retainedEntries, seedHash (Theta); n, k, m, numLevels, retainedItems, itemType, min, max, quantiles (KLL); streamLength, numActive, maxMapSize, maxMapCapacity, maximumError, itemType (Frequency). `quantiles` is an array of {rank, value}.",
      "type": "object",
      "additionalProperties": true
    },
    "contents": {
      "description": "Present when hashes or items are listed: retained Theta hashes, retained KLL items, or a Frequency sketch's items (the top 20 unless --show-items).",
      "type": "object",
      "properties": {
        "retainedHashes": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "unsigned 64-bit hash as a decimal string, to avoid precision loss"
          }
        },
        "retainedItems": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "string"
            ]
          },
          "description": "KLL items in storage order; long values are exact integers."
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "How many there are in all, which can exceed the number listed."
        },
        "frequentItems": {
          "type": "array",
          "description": "Frequency items, largest estimate first. The true count lies between lowerBound and upperBound.",
          "items": {
            "type": "object",
            "required": [
              "item",
              "estimate",
              "lowerBound",
              "upperBound"
            ],
            "properties": {
              "item": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "estimate": {
                "type": "integer",
                "minimum": 0
              },
              "lowerBound": {
                "type": "integer",
                "minimum": 0
              },
              "upperBound": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "recoverability": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "estimate-only",
            "hashes-only",
            "real-values",
            "needs-more-info"
          ]
        },
        "statement": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "statement"
      ]
    },
    "warnings": {
      "type": "array",
      "description": "Most important first.",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "confidence-medium",
              "seed-mismatch",
              "item-type-inferred",
              "input-normalized",
              "input-ambiguous",
              "option-ignored"
            ]
          },
          "message": {
            "type": "string"
          },
          "nextStep": {
            "type": "string"
          }
        }
      }
    },
    "diagnosis": {
      "description": "Present when status is not 0.",
      "type": "object",
      "required": [
        "code",
        "reason"
      ],
      "properties": {
        "code": {
          "enum": [
            "empty-input",
            "input-unreadable",
            "input-too-large",
            "multiple-blobs",
            "input-ambiguous",
            "too-short",
            "not-a-sketch",
            "unsupported-family",
            "unsupported-layout",
            "big-endian",
            "incomplete",
            "needs-item-type",
            "usage"
          ]
        },
        "reason": {
          "type": "string"
        },
        "nextStep": {
          "type": "string"
        },
        "rawPrefixHex": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$",
          "description": "The leading bytes, when fewer than 8 bytes were read and there is no `header`."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": 0
          }
        }
      },
      "then": {
        "required": [
          "header",
          "family",
          "summary",
          "recoverability"
        ]
      },
      "else": {
        "required": [
          "diagnosis"
        ]
      }
    }
  ]
}
